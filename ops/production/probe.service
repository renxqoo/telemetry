[Unit]
Description=OneAster external write and audited read probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=telemetry-probe
EnvironmentFile=/etc/oneaster/probe.env
ExecStart=/bin/sh /opt/oneaster/ops/production/probe.sh
TimeoutStartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
