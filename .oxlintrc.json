{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "apps/smoke/.next",
    "playwright-report",
    "test-results"
  ],
  "rules": { "typescript/no-floating-promises": "error" }
}
