{
  "name": "oneaster-telemetry",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "bun run scripts/check-architecture.ts && oxlint --type-aware --deny-warnings && bun fmt --check .",
    "format": "bun fmt .",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts && next build apps/smoke",
    "dev": "next dev apps/smoke --hostname 127.0.0.1 --port 4317",
    "start": "next start apps/smoke --hostname 127.0.0.1 --port 4318",
    "test:unit": "vitest run --coverage",
    "test:integration": "bun run scripts/integration.ts",
    "test:e2e": "playwright test",
    "test": "bun run test:integration && bun run test:e2e",
    "collector": "tsx apps/collector/src/main.ts",
    "query": "tsx apps/query-api/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:maintain": "tsx scripts/maintain.ts",
    "test:load": "tsx scripts/load.ts",
    "test:ha": "tsx scripts/ha.ts",
    "test:probe": "tsx ops/probe.ts",
    "config:convert": "tsx scripts/convert-config.ts",
    "db:finalize": "tsx scripts/migrate.ts --finalize"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "fastify": "5.12.7",
    "next": "16.4.3",
    "pg": "8.23.1",
    "protobufjs": "8.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oneaster/telemetry": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4"
}
